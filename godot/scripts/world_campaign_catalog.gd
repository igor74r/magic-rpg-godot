# 25 story missions ported from data/story.js.
class_name WorldCampaignCatalog
extends RefCounted
const MISSIONS := [{"id":"a1-m1","locationId":"briar-hollow","title":"Пепел на корневой тропе","desc":"Гоблины выкапывают светящиеся корни и тащат их к старому святилищу. Эдвин просит выяснить, кто приказал им тревожить землю.","enemyId":"goblin","count":3,"objective":"Остановить гоблинов-разорителей ×3","briefing":"Иара замечает, что гоблины выкапывают корни не ради еды: на каждом вырезан знак пяти лучей.","aftermath":"Гоблины разбегаются, а в земле остаётся медная печать с клеймом первого ордена.","clue":"Кто-то направляет даже тех, кто не понимает значения древних символов.","shardId":""},{"id":"a1-m2","locationId":"forest","title":"Следы под корнями","desc":"Скелет-страж охраняет древний корневой знак. Победите его, чтобы открыть проход к святилищу.","enemyId":"skeleton","count":1,"objective":"Победить скелета-стража ×1","briefing":"Следы скелета ведут к корню, который светится в такт осколку. Не повредите сам корень.","aftermath":"Корневой знак вспыхивает и показывает силуэт пяти фигур, связанных общей печатью.","clue":"Осколок хранит воспоминание, а не просто магическую энергию.","shardId":""},{"id":"a1-m3","locationId":"ruins","title":"Память под печатью","desc":"Тёмный рыцарь охраняет руины храма. Его броня исписана именами пяти орденов.","enemyId":"dark-knight","count":1,"objective":"Победить тёмного рыцаря ×1","briefing":"На броне рыцаря перечислены пять орденов, но имя шестого стерто грубой насечкой.","aftermath":"Рыцарь падает, и на внутренней стороне щита проступает знак затонувшего архива.","clue":"Кто-то намеренно удалил из хроник целую часть истории.","shardId":""},{"id":"a1-m4","locationId":"shadow","title":"Узел сумерек","desc":"Теневой маг охраняет древний знак на границе мира. Победите его, чтобы открыть путь к печати.","enemyId":"shadow-mage","count":1,"objective":"Победить теневого мага ×1","briefing":"Теневой маг повторяет фразу, которую Эдвин произносил в детстве героя: «Не открывай тишину».","aftermath":"Знак гасит локальную трещину, но на миг показывает нечто по ту сторону мира.","clue":"Тени помнят события до Раскола и боятся повторения.","shardId":""},{"id":"a1-m5","locationId":"briar-hollow","title":"Суд Древнего корня","desc":"Энт не позволит забрать семя памяти, пока не убедится, что герой ищет спасение, а не власть над Кристаллом.","enemyId":"elder-treant","count":1,"objective":"Пройти испытание Древнего энта ×1","briefing":"Древний энт не враг леса: он проверяет, способен ли герой услышать память, не подчиняя её себе.","aftermath":"Семя памяти принимает тепло героя и открывает путь к затонувшему некрополю.","clue":"Сила печати зависит от согласия хранителей.","shardId":""},{"id":"a2-m1","locationId":"swamp","title":"Голоса в трясине","desc":"У затопленных троп появились призрачные хранители. Их шёпот ведёт к архиву, но пока призраки не успокоятся, проход через топь останется закрыт.","enemyId":"ghost","count":3,"objective":"Успокоить болотных призраков ×3","briefing":"Призраки повторяют последние слова писцов, погибших при затоплении архива.","aftermath":"Их голоса складываются в координаты нижнего квартала.","clue":"У каждого ордена было собственное имя и собственная клятва.","shardId":""},{"id":"a2-m2","locationId":"graveyard","title":"Псы затопленных ворот","desc":"Криптовые гончие сторожат затопленные ворота и чуют живых по теплу дыхания. За ними скрыт вход в нижний квартал.","enemyId":"crypt-hound","count":2,"objective":"Победить криптовых гончих ×2","briefing":"Гончие охраняют не сокровища, а двери, за которыми укрывали свидетелей Раскола.","aftermath":"В ошейнике одной гончей найден ключ с символом архивариуса.","clue":"Свидетелей пытались спрятать даже от смерти.","shardId":""},{"id":"a2-m3","locationId":"sunken-necropolis","title":"Колокол под водой","desc":"Костяной колосс держит цепь древнего колокола. Каждый его удар стирает ещё одну страницу памяти из стен некрополя.","enemyId":"bone-colossus","count":2,"objective":"Разрушить стражей колокола ×2","briefing":"Колоссы удерживают цепь колокола, чей звон стирает воспоминания из камня.","aftermath":"После разрушения стражей колокол звучит один раз и возвращает часть имён.","clue":"Память можно уничтожить, но её следы остаются в мире.","shardId":""},{"id":"a2-m4","locationId":"library","title":"Архивариус без имени","desc":"Архимаг библиотеки переписывает летопись, стирая из неё имена пяти орденов. Верните истинный текст, пока страницы не забыли собственные строки.","enemyId":"archmage","count":1,"objective":"Остановить Архивариуса ×1","briefing":"Архивариус переписывает страницы, потому что считает правду опаснее забвения.","aftermath":"В восстановленной летописи появляется имя Немого и упоминание огненной кузницы.","clue":"Первый Раскол был следствием решения хранителей, а не нападения извне.","shardId":""},{"id":"a2-m5","locationId":"sunken-necropolis","title":"Трон без дыхания","desc":"Костяной тиран запер архив и пытается сжечь последнюю летопись холодным пламенем. Не дайте ему уничтожить правду.","enemyId":"bone-tyrant","count":1,"objective":"Одержать победу над Костяным тираном ×1","briefing":"Тиран хочет сжечь последнюю летопись, чтобы никто не узнал о добровольной клятве.","aftermath":"Архив спасён; на последней странице проступает схема кузницы под обсидиановыми полями.","clue":"Следующая печать была выкована из согласия, а не из власти.","shardId":""},{"id":"a3-m1","locationId":"volcano","title":"Искры из расколотой жилы","desc":"Огненные элементали вырывают из земли жилы синего камня. Если они доберутся до кузницы, вся долина вспыхнет.","enemyId":"fire-elemental","count":3,"objective":"Остановить огненных элементалей ×3","briefing":"Элементали собирают синие жилы: они питают не лаву, а механизм под кузницей.","aftermath":"В жилах найден осколок формулы, который реагирует на руны пяти орденов.","clue":"Кузница всё ещё работает, хотя её мастера давно исчезли.","shardId":""},{"id":"a3-m2","locationId":"wasteland","title":"Дюны под кожей","desc":"Песчаные черви роют ходы под караванным трактом и выводят на поверхность чёрное стекло. Под песком скрыта жила, ведущая к кузнице.","enemyId":"sand-worm","count":2,"objective":"Изгнать песчаных червей ×2","briefing":"Черви прокладывают путь к погребённым трубам, по которым когда-то шла мана.","aftermath":"Под песком найдено клеймо мастера, подписавшего договор от имени пяти орденов.","clue":"В договоре есть пустое место для подписи, оставленное намеренно.","shardId":""},{"id":"a3-m3","locationId":"obsidian-fields","title":"Караул чёрного стекла","desc":"Обсидиановые стражи считают героя нарушителем договора. На их щитах выгравирована клятва пяти орденов.","enemyId":"obsidian-guard","count":2,"objective":"Победить обсидиановых стражей ×2","briefing":"Стражи считают героя нарушителем, потому что древний договор не распознал нового хранителя.","aftermath":"После боя щит стража раскрывает формулу: ни один орден не мог владеть печатью единолично.","clue":"Предательство началось, когда один орден попытался присвоить общий источник.","shardId":""},{"id":"a3-m4","locationId":"volcano","title":"Гул под горой","desc":"Магмовые големы питают кузницу, заставляя её работать без мастеров. Разбейте их сердечники и остановите перегрев.","enemyId":"magma-golem","count":2,"objective":"Разрушить магмовых големов ×2","briefing":"Големы поддерживают перегрев кузницы, чтобы расплавить формулу и скрыть следы.","aftermath":"Остывший сердечник содержит память последнего мастера о принесённой клятве.","clue":"Клятва была добровольной, но страх сделал её похожей на цепь.","shardId":""},{"id":"a3-m5","locationId":"obsidian-fields","title":"Пепельный Вестник","desc":"Дракон-печать пробудился в сердце обсидиановых полей. Победите его и заберите первый осколок Кристалла Разлома.","enemyId":"flame-lord","count":1,"objective":"Победить Пепельного Вестника ×1","briefing":"Пепельный Вестник — первая из трёх живых печатей Разлома.","aftermath":"Дракон повержен, и герой получает Осколок Пламени. Разлом остаётся закрытым, пока живы два других дракона.","clue":"Осколок нельзя получить иначе, чем победив его хранителя.","shardId":""},{"id":"a4-m1","locationId":"ice-peaks","title":"Следы в белой мгле","desc":"Морозные волки преследуют караваны с припасами. На их шерсти проступают метки ордена, будто зверей направляет сама крепость.","enemyId":"frost-wolf","count":3,"objective":"Отогнать морозных волков ×3","briefing":"Волки не нападают первыми: они загоняют караваны под защиту старых ледяных знаков.","aftermath":"На ошейниках обнаружены метки ордена, который поклялся хранить память.","clue":"Крепость заморозила долину, чтобы сохранить свидетельство.","shardId":""},{"id":"a4-m2","locationId":"frost-citadel","title":"Шёпот инея","desc":"Ведьмы инея стирают воспоминания путников, превращая их в безмолвных дозорных. Их заклинания нужно прервать до наступления метели.","enemyId":"rime-witch","count":2,"objective":"Победить ведьм инея ×2","briefing":"Ведьмы инея крадут воспоминания, потому что считают их источником боли.","aftermath":"Освобождённый пленник вспоминает имя Эдвина на стене внутреннего зала.","clue":"Эдвин был связан с последним орденом гораздо теснее, чем признавал.","shardId":""},{"id":"a4-m3","locationId":"ice-peaks","title":"Сердце ледника","desc":"Ледяные элементали удерживают в толще льда воспоминание о предательстве. Их холод не даст подойти к внутренним воротам.","enemyId":"ice-elemental","count":2,"objective":"Освободить проход от элементалей ×2","briefing":"Элементали держат во льду не артефакт, а воспоминание о дне предательства.","aftermath":"Лёд тает и показывает пятерых хранителей, спорящих у расколотого Кристалла.","clue":"Никто из них не хотел уничтожить мир — они боялись потерять контроль.","shardId":""},{"id":"a4-m4","locationId":"frost-citadel","title":"Страж сломанной клятвы","desc":"Ледяной великан охраняет зал, где хранительница принесла последнюю клятву. На его груди застыл знак Эдвина.","enemyId":"frost-giant","count":1,"objective":"Победить ледяного великана ×1","briefing":"Великан получил знак Эдвина, когда тот покинул крепость много лет назад.","aftermath":"За его стражей открывается зал с последней клятвой и записью ученика.","clue":"Эдвин скрыл правду, чтобы не дать повторить ошибку.","shardId":""},{"id":"a4-m5","locationId":"frost-citadel","title":"Ледяная Хватка","desc":"В сердце крепости пробуждается второй дракон-печать. Победите Ледяную Хватку и получите Осколок Льда.","enemyId":"ice-queen","count":1,"objective":"Победить Ледяную Хватку ×1","briefing":"Вторая живая печать удерживает Разлом ледяной хваткой.","aftermath":"Дракон повержен, и герой получает Осколок Льда. Последняя печать находится за стенами столицы.","clue":"Даже два осколка не откроют Разлом, пока жив последний дракон.","shardId":""},{"id":"a5-m1","locationId":"dragon-lair","title":"Дети расколотого пламени","desc":"Дракончики вылупились из трещин пространства. Они не злы, но их дыхание открывает новые разрывы, поэтому путь нужно очистить.","enemyId":"dragonling","count":3,"objective":"Победить дракончиков Бездны ×3","briefing":"Дракончики рождаются из трещин и не понимают, что их дыхание разрывает пространство.","aftermath":"В их чешуе обнаружены следы пяти печатей, смешанных в одну.","clue":"Разлом меняет живых существ, а не только землю.","shardId":""},{"id":"a5-m2","locationId":"dragon-lair","title":"Пламя между мирами","desc":"Огненные драконы перелетают через разломы и сжигают островки устойчивой земли. Не дайте им замкнуть кольцо вокруг кратера.","enemyId":"fire-drake","count":2,"objective":"Остановить огненных драконов ×2","briefing":"Драконы защищают островки реальности, но пламя заставляет их нападать на всё вокруг.","aftermath":"После боя путь к древней стражe становится устойчивым.","clue":"Даже чудовища Бездны могут быть жертвами Раскола.","shardId":""},{"id":"a5-m3","locationId":"dragon-lair","title":"Последняя стража печати","desc":"Драконы-стражи проверяют, собраны ли все пять свидетельств. Их древняя клятва не позволяет им отступить без боя.","enemyId":"dragon-guardian","count":2,"objective":"Победить драконов-стражей ×2","briefing":"Стражи проверяют не силу героя, а собраны ли свидетельства всех пяти земель.","aftermath":"Их клятва признаёт героя носителем памяти, но не владельцем Кристалла.","clue":"Новый хранитель должен разделить ответственность, а не власть.","shardId":""},{"id":"a5-m4","locationId":"void-crater","title":"Глашатай Немого","desc":"Глашатаи Бездны говорят голосами тех, кого герой встретил в пути. Они пытаются убедить его, что мир не заслуживает спасения.","enemyId":"void-harbinger","count":2,"objective":"Заглушить глашатаев Немого ×2","briefing":"Глашатаи говорят голосами знакомых людей и предлагают отказаться от мира, который ошибается.","aftermath":"Их голоса исчезают, когда герой называет правду о пяти орденах.","clue":"Немой питается страхом и одиночеством, а не только разрушением.","shardId":""},{"id":"a5-m5","locationId":"dragon-lair","title":"Кровавая Корона","desc":"Последний дракон-печать ждёт в сердце столицы. Победите Кровавую Корону: его гибель разрушит последнюю печать и откроет Разлом.","enemyId":"ancient-dragon","count":1,"objective":"Убить Кровавую Корону ×1","briefing":"Кровавая Корона — последняя из трёх живых печатей. Пока он жив, Разлом закрыт.","aftermath":"Кровавая Корона повержен. Третий осколок — Осколок Крови — собран; начинается раскрытие Разлома.","clue":"Три осколка стабилизируют то, что выйдет из Разлома, но не являются ключом его открытия.","shardId":""}]
static func all_missions() -> Array:
	return MISSIONS.duplicate(true)
static func find_mission(mission_id: String) -> Dictionary:
	for mission in MISSIONS:
		if str(mission.id)==mission_id:return mission.duplicate(true)
	return {}
