const ANGLES := [-90.0,-18.0,54.0,126.0,198.0]
const LEVEL_REQUIREMENTS := [2,5,10,15,25,35]
static func get_tree(class_id: String) -> Dictionary:
	var key := class_id if BRANCHES.has(class_id) else "warrior"
	var nodes: Dictionary = {"start":{"id":"start","x":50.0,"y":50.0,"name":"Начало пути","desc":"Центр вашего мастерства","type":"start","icon":"✦","conn":[],"effects":{}}}
	var branches: Array = BRANCHES[key]
	for branch_index in range(branches.size()):
		var branch: Dictionary = branches[branch_index]
		var previous := "start"
		var angle := deg_to_rad(float(ANGLES[branch_index]))
		for index in range(branch.nodes.size()):
			var entry: Dictionary = branch.nodes[index]
			var radius := 17.0 + float(index)*11.0
			var node_id := "%s-%s-%d" % [key,str(branch.id),index+1]
			nodes[node_id] = {"id":node_id,"x":clampf(50.0+cos(angle)*radius,5.0,95.0),"y":clampf(50.0+sin(angle)*radius,5.0,95.0),"name":entry.name,"desc":entry.desc,"type":entry.type,"icon":entry.icon,"conn":[previous],"branch":branch.name,"levelReq":LEVEL_REQUIREMENTS[index],"effects":entry.effects.duplicate(true)}
			previous=node_id
	for branch_index in range(branches.size()):
		var branch: Dictionary = branches[branch_index]
		var next: Dictionary = branches[(branch_index+1)%branches.size()]
		for tier_index in [3,5]:
			var from_id := "%s-%s-%d" % [key,str(branch.id),tier_index]
			var to_id := "%s-%s-%d" % [key,str(next.id),tier_index]
			var from_node: Dictionary = nodes[from_id]
			if not from_node.conn.has(to_id): from_node.conn.append(to_id)
	return {"classId":key,"nodes":nodes}
static func get_node(class_id: String,node_id: String) -> Dictionary:
	return get_tree(class_id).nodes.get(node_id,{}).duplicate(true)
